# Copy to .env for local development. Never commit .env.

ENV=development
PORT=8080
DATABASE_URL=postgres://memoria:memoria@localhost:5432/memoria?sslmode=disable
JWT_SECRET=dev-only-secret-do-not-use-in-prod

# Gmail SMTP (use an App Password: https://myaccount.google.com/apppasswords).
# Leave SMTP_HOST empty in development to log OTP codes instead of emailing.
# SMTP_FROM must match SMTP_USERNAME on personal Gmail; use a Workspace alias for noreply@.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Media storage (S3-compatible: MinIO locally, R2 in production) ---
# S3_PUBLIC_ENDPOINT is the host clients see in presigned URLs (defaults to
# S3_ENDPOINT). Needed when the API reaches MinIO on a docker network name.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoria
S3_SECRET_KEY=memoria-secret
S3_BUCKET=memoria-media
S3_USE_PATH_STYLE=true

# Expo Push (optional in dev — outbox still creates in-app feed entries).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# RevenueCat subscriptions (Phase B8).
# In RC dashboard → Project → Integrations → Webhooks:
#   URL: https://<your-api-host>/v1/webhooks/revenuecat
#   Authorization: Bearer <same value as REVENUECAT_WEBHOOK_SECRET>
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PRODUCT_PLUS=memoria_plus
REVENUECAT_PRODUCT_PRO=memoria_pro

# --- Production hardening (B11) ---
# SENTRY_DSN=
# DB_MAX_CONNS=20
